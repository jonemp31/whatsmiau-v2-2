# Configurações da API Whatsmiau
PORT=8080
API_KEY=your_secure_api_key_here_change_this_in_production

# Configurações do Redis
REDIS_URL=redis:6379
REDIS_PASSWORD=
REDIS_TLS=false

# Configurações do Banco de Dados
DIALECT_DB=sqlite3
DB_URL=file:/app/data/data.db?_foreign_keys=on

# Configurações de Webhook Global
GLOBAL_WEBHOOK_URL=

# Configurações de Debug
DEBUG_MODE=false
DEBUG_WHATSMEOW=false

# Configurações do Google Cloud Storage (opcional)
GCS_ENABLED=false
GCS_BUCKET=whatsmiau
GCS_URL=https://storage.googleapis.com

# Configurações do Google Cloud Logging (opcional)
GCL_ENABLED=false
GCL_APP_NAME=whatsmiau-br-1
GCL_PROJECT_ID=

# Configurações de Performance
EMITTER_BUFFER_SIZE=2048
HANDLER_SEMAPHORE_SIZE=512
CONVERTER_WORKERS=10
CONVERTER_HTTP_TIMEOUT=30
